// Centering Material Rental ERP - Prisma Schema
// Provider: PostgreSQL (works with Supabase, Neon, RDS, local Postgres)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RateType {
  PER_DAY
  PER_WEEK
  PER_MONTH
}

enum AssetCondition {
  NEW
  GOOD
  USED
  DAMAGED
}

enum AssetStatus {
  AVAILABLE
  LOW_STOCK
  OUT_OF_STOCK
}

enum RentalStatus {
  ACTIVE
  PARTIALLY_RETURNED
  RETURNED
  OVERDUE
  CLOSED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
}

enum InvoiceStatus {
  PAID
  PARTIALLY_PAID
  PENDING
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Customer {
  id              Int       @id @default(autoincrement())
  customerCode    String    @unique
  name            String
  mobile          String
  alternateMobile String?
  address         String?
  projectName     String?
  projectAddress  String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  rentals Rental[]

  @@index([name])
  @@index([mobile])
}

model Asset {
  id                Int           @id @default(autoincrement())
  assetCode         String        @unique
  name              String
  category          String
  unit              String
  totalQuantity     Int
  availableQuantity Int
  rentalRate        Decimal       @db.Decimal(10, 2)
  rateType          RateType      @default(PER_DAY)
  condition         AssetCondition @default(GOOD)
  status            AssetStatus   @default(AVAILABLE)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  rentalItems RentalItem[]

  @@index([category])
  @@index([name])
}

model Rental {
  id              Int          @id @default(autoincrement())
  rentalNumber    String       @unique
  customerId      Int
  rentalDate      DateTime
  dueDate         DateTime
  returnDate      DateTime?
  status          RentalStatus @default(ACTIVE)

  subtotal        Decimal      @default(0) @db.Decimal(10, 2)
  transportCharge Decimal      @default(0) @db.Decimal(10, 2)
  otherCharge     Decimal      @default(0) @db.Decimal(10, 2)
  discount        Decimal      @default(0) @db.Decimal(10, 2)
  securityDeposit Decimal      @default(0) @db.Decimal(10, 2)
  advancePaid     Decimal      @default(0) @db.Decimal(10, 2)

  overdueCharge   Decimal      @default(0) @db.Decimal(10, 2)
  damageCharge    Decimal      @default(0) @db.Decimal(10, 2)
  missingCharge   Decimal      @default(0) @db.Decimal(10, 2)

  grandTotal      Decimal      @default(0) @db.Decimal(10, 2)
  balanceAmount   Decimal      @default(0) @db.Decimal(10, 2)

  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id])
  items    RentalItem[]
  returns  Return[]
  payments Payment[]
  invoice  Invoice?

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

model RentalItem {
  id               Int     @id @default(autoincrement())
  rentalId         Int
  assetId          Int

  rentedQuantity   Int
  returnedQuantity Int     @default(0)
  damagedQuantity  Int     @default(0)
  missingQuantity  Int     @default(0)

  rentalRate       Decimal @db.Decimal(10, 2)
  rentalDays       Int
  amount           Decimal @db.Decimal(10, 2)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rental      Rental       @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  asset       Asset        @relation(fields: [assetId], references: [id])
  returnItems ReturnItem[]

  @@index([rentalId])
  @@index([assetId])
}

model Return {
  id             Int      @id @default(autoincrement())
  rentalId       Int
  returnDate     DateTime @default(now())
  notes          String?
  missingDetails String?
  damageDetails  String?
  overdueDays    Int      @default(0)
  overdueCharge  Decimal  @default(0) @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  rental Rental       @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  items   ReturnItem[]

  @@index([rentalId])
}

model ReturnItem {
  id               Int     @id @default(autoincrement())
  returnId         Int
  rentalItemId     Int

  returnedQuantity Int
  damagedQuantity  Int     @default(0)
  missingQuantity  Int     @default(0)

  damageCharge     Decimal @default(0) @db.Decimal(10, 2)
  missingCharge    Decimal @default(0) @db.Decimal(10, 2)

  return     Return     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  rentalItem RentalItem @relation(fields: [rentalItemId], references: [id])

  @@index([returnId])
  @@index([rentalItemId])
}

model Payment {
  id              Int           @id @default(autoincrement())
  rentalId        Int
  paymentDate     DateTime      @default(now())
  amount          Decimal       @db.Decimal(10, 2)
  paymentMethod   PaymentMethod @default(CASH)
  referenceNumber String?
  notes           String?
  createdAt       DateTime      @default(now())

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@index([rentalId])
  @@index([paymentDate])
}

model Invoice {
  id              Int           @id @default(autoincrement())
  invoiceNumber   String        @unique
  rentalId        Int           @unique
  invoiceDate     DateTime      @default(now())

  subtotal        Decimal       @default(0) @db.Decimal(10, 2)
  overdueCharge   Decimal       @default(0) @db.Decimal(10, 2)
  damageCharge    Decimal       @default(0) @db.Decimal(10, 2)
  missingCharge   Decimal       @default(0) @db.Decimal(10, 2)
  transportCharge Decimal       @default(0) @db.Decimal(10, 2)
  otherCharge     Decimal       @default(0) @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  grandTotal      Decimal       @default(0) @db.Decimal(10, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(10, 2)
  balanceAmount   Decimal       @default(0) @db.Decimal(10, 2)
  status          InvoiceStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([invoiceDate])
}