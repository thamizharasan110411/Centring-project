# PostgreSQL connection string
# Local:     postgresql://USER:PASSWORD@localhost:5432/centering_erp
# Neon:      postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/centering_erp?sslmode=require
# Supabase:  postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/centering_erp

# Backend server port
PORT=5000

# Allowed frontend origin(s) for CORS - comma separated
FRONTEND_URL=http://localhost:5173

# Business details (shown on invoices)
BUSINESS_NAME=Centring Materials
BUSINESS_ADDRESS=Plot No. 12, Industrial Area, Hosur Road, Bengaluru - 560100
BUSINESS_PHONE=+91 98765 43210
BUSINESS_EMAIL=info@balajicentering.in

# --- Admin login (single admin account) ---
# Change these before deploying! The frontend login page uses these credentials.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Secret used to sign session tokens. Generate one, e.g. openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Session validity (default 24h)
JWT_EXPIRES_IN=24h