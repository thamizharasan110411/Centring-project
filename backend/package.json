{
  "name": "centering-erp-backend",
  "version": "1.0.0",
  "description": "Centering Material Rental ERP - Backend API",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
