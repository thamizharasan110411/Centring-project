{
  "version": 2,
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/system/clean-db",
      "schedule": "0 0 1 */2 *"
    }
  ],
  "builds": [
    {
      "src": "src/app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/app.js"
    }
  ]
}